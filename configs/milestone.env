# ============================================================================
# milestone.env — central config sourced by every script in scripts/
# Edit the values below before the first run, then: source configs/milestone.env
# ============================================================================

# --- EOGS source (third-party repo; cloned OUTSIDE this git tree) -------------
EOGS_REPO_URL="https://github.com/mezzelfo/EOGS.git"
EOGS_DIR="${HOME}/eogs-src/EOGS"          # where to clone EOGS
# Pin a commit for reproducibility once your first run works (record in STATUS §7):
EOGS_COMMIT=""                             # empty = use default branch (master)

# --- EOGS bundled benchmark data (release asset: tiles + DSM ground truth) ----
EOGS_DATA_ZIP_URL="https://github.com/mezzelfo/EOGS/releases/download/dataset_v01/data.zip"
# Data extracts into ${EOGS_DIR}/data  (images/, rpcs/, truth/)

# --- Conda env ----------------------------------------------------------------
CONDA_ENV="eogs"
PYTHON_VERSION="3.10"

# --- PyTorch CUDA wheels ------------------------------------------------------
# 4090 supports CUDA 12.x. cu121 is a safe default; switch to cu124 if your
# driver is newer and cu121 wheels mismatch. Check with: nvidia-smi
TORCH_INDEX_URL="https://download.pytorch.org/whl/cu121"

# --- Scenes -------------------------------------------------------------------
# JAX tiles are our eval focus / quick milestone. SMOKE_SCENE = fast single-tile.
MILESTONE_SCENES="JAX_004 JAX_068 JAX_214 JAX_260"
SMOKE_SCENE="JAX_004"
# PREP_SCENES = the FULL set that `train.sh reproduceMain` trains. ALL of these
# need camera prep (affine_models.json) or they error with "Could not recognize
# scene type". This matches the EOGS README's to_affine list (4 JAX + 3 IARPA).
PREP_SCENES="JAX_004 JAX_068 JAX_214 JAX_260 IARPA_001 IARPA_002 IARPA_003"

# --- Where our own results/logs go (small, git-trackable) --------------------
REPO_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]:-$0}" )/.." && pwd )"
RESULTS_DIR="${REPO_ROOT}/results"
LOG_DIR="${REPO_ROOT}/results/logs"
